# Streamlit Cloud: App settings -> Secrets. Paste this, fill it in, then add the [users.*] blocks
# from coding_lab/logins/users_for_secrets.toml (created by make_logins.py).
# Local testing: save as .streamlit/secrets.toml in the folder you run streamlit from (never commit it).

OPENAI_API_KEY = "sk-..."

[lab]
cohort_name = "AI Coding Lab"
model = "gpt-4.1-mini"
max_evaluations_per_task = 1     # each task can be evaluated once
cell_timeout_seconds = 60

[storage]                        # where participants' work is saved (a PRIVATE GitHub repo)
github_repo = "your-account/coding-lab-data"
github_token = "github_pat_..."  # fine-grained token: that repo only, Contents: Read and write
branch = "main"
folder = "lab-data"

# [users.LD001]
